$TTL 86400
@       IN SOA  domain-ns.example.com. admin.example.com. (
                        2026102300 ; serial
                        3600       ; refresh
                        1800       ; retry
                        604800     ; expire
                        86400 )    ; minimum
@                       IN NS   domain-ns.example.com.
domain-ns.example.com.  IN A    172.16.3.30

@       IN A    172.16.1.20
www     IN A    172.16.1.20
admin   IN A    172.16.3.41
dev     IN A    172.16.3.42
git     IN A    172.16.3.43
mail    IN A    172.16.3.44
vpn     IN A    172.16.3.45
